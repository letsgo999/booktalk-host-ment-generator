<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>북톡방 독서토론 멘트 생성기</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap');
        body { font-family: 'Pretendard', sans-serif; background-color: #f8fafc; }
        .hidden { display: none !important; }
    </style>
</head>
<body class="text-slate-900 min-h-screen flex flex-col">

    <header class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-20 flex justify-between items-center shadow-sm">
        <div class="flex items-center gap-3">
            <div class="bg-blue-600 p-2 rounded-lg shadow-blue-200 shadow-lg text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h1 class="text-lg font-bold text-slate-800">북톡방 멘트 생성기</h1>
        </div>
        <button onclick="toggleSettings(true)" id="btn-settings" class="p-2 rounded-full transition-colors text-red-500 bg-red-50 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </header>

    <main class="flex-1 max-w-3xl mx-auto w-full p-4 py-8 relative">
        
        <div id="api-alert" class="mb-6 bg-red-50 border border-red-100 rounded-xl p-4 flex items-center gap-3 text-red-700 text-sm shadow-sm hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <p><strong>API 키 설정 필요:</strong> 도서 분석을 위해 우측 상단 톱니바퀴(설정)를 클릭해 API 키를 입력해 주세요.</p>
        </div>

        <div id="error-alert" class="mb-6 bg-red-50 border border-red-200 rounded-xl p-4 flex items-start gap-3 text-red-800 text-sm hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <p id="error-text">오류가 발생했습니다.</p>
        </div>

        <div id="view-input" class="bg-white rounded-2xl shadow-xl border border-slate-200 p-8 md:p-12 text-center space-y-6 block">
            <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            </div>
            <div class="space-y-2">
                <h2 class="text-2xl font-bold text-slate-800">토론할 책의 URL 주소를 알려 주세요!</h2>
                <p class="text-slate-500">분석하고 싶은 도서 상세 페이지 링크를 입력하세요.</p>
            </div>
            
            <form onsubmit="handleAnalyze(event)" class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1 text-slate-400">
                    <div class="absolute left-4 top-1/2 -translate-y-1/2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    </div>
                    <input type="text" id="url-input" placeholder="https://www.yes24.com/..." class="w-full pl-12 pr-4 py-4 bg-slate-100 border-2 border-transparent rounded-xl focus:border-blue-500 focus:bg-white outline-none transition-all font-medium text-slate-800" required />
                </div>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-xl font-bold transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-100">
                    생성하기
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </form>
        </div>

        <div id="view-loading" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-16 text-center space-y-4 hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 animate-spin mx-auto"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            <p class="text-lg font-bold text-slate-800">도서 정보를 살펴보고 있어요...</p>
            <p class="text-sm text-slate-500">웹 검색과 AI 분석에 20~40초 정도 걸립니다.</p>
        </div>

        <div id="view-result" class="space-y-6 hidden">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
                <div class="bg-slate-900 p-8 text-white">
                    <div class="flex items-center gap-2 text-blue-400 mb-2 text-sm font-bold tracking-wider">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                        ANALYSIS COMPLETE
                    </div>
                    <h2 id="res-title" class="text-2xl font-bold">책 제목 위치</h2>
                </div>
                
                <div class="p-8 space-y-10">
                    <section class="space-y-4">
                        <h3 class="flex items-center gap-2 font-bold text-xl text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                            <span class="text-slate-900">오프닝 초대 멘트</span>
                        </h3>
                        <div id="res-intro" class="bg-slate-50 p-6 rounded-2xl border-l-4 border-blue-600 italic text-slate-700 leading-relaxed text-lg">
                            오프닝 멘트
                        </div>
                    </section>

                    <section class="space-y-4">
                        <h3 class="flex items-center gap-2 font-bold text-xl text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            <span class="text-slate-900">함께 나눌 토론 질문 5선</span>
                        </h3>
                        <div id="res-themes" class="grid gap-3"></div>
                    </section>

                    <section class="space-y-4">
                        <h3 class="flex items-center gap-2 font-bold text-xl text-blue-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span class="text-slate-900">발제자 풀어주는 질문 3선</span>
                        </h3>
                        <div id="res-presenter" class="grid gap-3"></div>
                    </section>
                </div>
                
                <div class="bg-slate-50 p-6 border-t border-slate-200 flex justify-center">
                    <button onclick="resetView()" class="text-sm font-bold text-slate-400 hover:text-blue-600 transition-colors uppercase tracking-widest">
                        ← 새로운 책 분석하기
                    </button>
                </div>
            </div>
        </div>
    </main>

    <div id="modal-settings" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div class="flex items-center gap-2 font-bold text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/></svg>
                    <span class="text-slate-800">API 설정</span>
                </div>
                <button onclick="toggleSettings(false)" class="text-slate-400 hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <form onsubmit="saveSettings(event)" class="p-6 space-y-4">
                <div class="space-y-2">
                    <label class="text-sm font-semibold text-slate-700">Gemini API Key</label>
                    <input type="password" id="api-key-input" placeholder="키를 입력하세요 (AI Studio에서 발급)" class="w-full p-3 bg-slate-100 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" required />
                    <p class="text-[10px] text-slate-400">* 키는 브라우저 내부 보관함(LocalStorage)에만 안전하게 저장됩니다.</p>
                </div>
                <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold transition-all shadow-lg shadow-blue-200">
                    설정 저장
                </button>
            </form>
        </div>
    </div>

    <footer class="py-8 text-center text-slate-400 text-[10px] tracking-tight uppercase font-medium mt-auto">
        <p>© 2025 SOCIAL SCHOOL SUNDAY NIGHT BOOK-TALK HOST TOOL</p>
    </footer>

    <script>
        let apiKey = '';

        window.addEventListener('DOMContentLoaded', function() {
            try {
                const savedKey = localStorage.getItem('btb_api_key');
                if (savedKey) {
                    apiKey = savedKey;
                    updateHeaderIcon(true);
                } else {
                    document.getElementById('api-alert').classList.remove('hidden');
                    updateHeaderIcon(false);
                }
            } catch (err) {
                console.warn('localStorage 접근 불가:', err);
                document.getElementById('api-alert').classList.remove('hidden');
                updateHeaderIcon(false);
            }
        });

        function toggleSettings(show) {
            const modal = document.getElementById('modal-settings');
            const input = document.getElementById('api-key-input');
            if (show) {
                input.value = apiKey;
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }

        function saveSettings(e) {
            e.preventDefault();
            apiKey = document.getElementById('api-key-input').value.trim();
            try {
                localStorage.setItem('btb_api_key', apiKey);
            } catch (err) {
                console.warn('localStorage 저장 불가:', err);
            }
            document.getElementById('api-alert').classList.add('hidden');
            updateHeaderIcon(true);
            toggleSettings(false);
        }

        function updateHeaderIcon(hasKey) {
            const btn = document.getElementById('btn-settings');
            if (hasKey) {
                btn.className = "p-2 rounded-full transition-colors text-slate-400 hover:bg-slate-100";
            } else {
                btn.className = "p-2 rounded-full transition-colors text-red-500 bg-red-50 animate-pulse";
            }
        }

        function setView(viewName) {
            document.getElementById('view-input').classList.add('hidden');
            document.getElementById('view-loading').classList.add('hidden');
            document.getElementById('view-result').classList.add('hidden');
            
            if (viewName === 'input') document.getElementById('view-input').classList.remove('hidden');
            if (viewName === 'loading') document.getElementById('view-loading').classList.remove('hidden');
            if (viewName === 'result') document.getElementById('view-result').classList.remove('hidden');
        }

        function showError(msg) {
            const errBox = document.getElementById('error-alert');
            document.getElementById('error-text').innerText = msg;
            errBox.classList.remove('hidden');
            setView('input');
        }

        function resetView() {
            document.getElementById('url-input').value = '';
            document.getElementById('error-alert').classList.add('hidden');
            setView('input');
        }

        function extractJson(text) {
            let cleaned = text.replace(/```json/gi, '').replace(/```/g, '').trim();
            const start = cleaned.indexOf('{');
            const end = cleaned.lastIndexOf('}');
            if (start !== -1 && end !== -1 && end > start) {
                cleaned = cleaned.substring(start, end + 1);
            }
            return JSON.parse(cleaned);
        }

        async function handleAnalyze(e) {
            e.preventDefault();
            document.getElementById('error-alert').classList.add('hidden');

            if (!apiKey) {
                showError("우측 상단 톱니바퀴 아이콘을 눌러 API 키를 먼저 설정해 주세요.");
                toggleSettings(true);
                return;
            }

            const url = document.getElementById('url-input').value.trim();
            if (!url) return;

            setView('loading');

            // ─────────────────────────────────────────────────────────────
            // 시스템 프롬프트: 거실 소파 분위기로 전면 재작성
            // ─────────────────────────────────────────────────────────────
            const systemPrompt = `당신은 [일욜밤 북톡방]의 따뜻한 진행자입니다.
일요일 밤, 책을 좋아하는 사람들이 둘러앉아 편하게 이야기 나누는 분위기를 만드는 게 당신의 역할입니다.

[가장 중요한 톤앤매너 규칙]
이 모임은 학술 토론회나 세미나가 아닙니다. 거실 소파에 둘러앉아 차 한 잔 마시며 책 이야기 나누는 자리예요.
질문을 받는 사람이 "어, 그거 나도 생각해봤는데" 하고 자연스럽게 입을 열 수 있어야 합니다.

[질문 만들 때 반드시 피해야 할 것들]
- "근본적인", "본질적인", "심층적인", "방법론적", "통찰적", "패러다임" 같은 무거운 학술 용어
- "~에 대한 구체적인 제언을 듣고 싶습니다" 같은 인터뷰어 같은 어투
- 한 질문 안에 묻는 것이 두세 개씩 들어 있는 복합 질문 (질문은 하나만 또렷하게)
- 책의 핵심 키워드를 그대로 따라 써서 만든 추상적 질문
  (예: 책에 '파괴'가 나오면 "건설적 파괴와 무모한 파괴의 경계는?" 같은 질문 금지)
- 발제자에게 "방법론을 제시해 달라", "전망을 말해 달라"고 요구하는 질문

[좋은 질문의 특징]
- 자기 일상이나 경험에서 답을 꺼낼 수 있는 질문
- "혹시 이런 적 있으세요?", "어떤 장면이 떠오르셨어요?" 같은 부드러운 톤
- 책의 한 부분, 한 인물, 한 장면에 초점을 맞춘 구체적인 질문
- 정답이 없고 각자 다르게 답할 수 있는 열린 질문
- 학생이 아니라 친구한테 물어보는 듯한 어투

[테마 토론 질문 5개 — 함께 나눌 일반 질문]
일상의 감각으로 책을 다시 읽게 하는 질문. "내 삶에 적용하면 어떨까?" 정도의 가벼운 깊이.
어렵지 않게, 누구나 자기 이야기로 풀어낼 수 있게.
좋은 톤 예시:
- "이 책에서 가장 마음에 남은 장면이나 문장이 있다면 어떤 거였어요?"
- "책 읽다가 '아, 이건 나도 그래' 싶었던 부분이 있었나요?"
- "이 책 속 인물 중 한 명이 옆자리에 있다면 뭘 가장 묻고 싶으세요?"
- "책을 덮고 나서 일상에서 살짝 달리 보이게 된 게 있다면요?"

[발제자 풀어주는 질문 3개]
이건 발제자를 추궁하거나 시험하는 질문이 절대 아닙니다.
발제자가 책 이야기를 더 신나게, 더 풍부하게 풀어낼 수 있도록 멍석을 깔아주는 질문입니다.
발제자가 "아, 그 얘기 내가 하고 싶었어요!" 하고 반가워할 만한 질문.
좋은 톤 예시:
- "이 책을 고른 특별한 이유가 있으세요?"
- "읽으면서 가장 밑줄 많이 그은 부분이 어디였어요?"
- "이 책 누구한테 추천하고 싶으세요? 왜요?"
- "책에서 저자랑 살짝 의견이 다르거나 갸우뚱했던 부분이 있다면요?"
- "발제 준비하면서 새롭게 알게 된 거나 인상 깊었던 게 있다면 살짝 들려주세요."

[오프닝 멘트]
계절감을 살짝 담되 너무 길지 않게 3-4문장. 어려운 한자어나 추상적 표현은 자제.
"오늘은 이런 책을 함께 읽어봤어요. 같이 이야기 나눠봐요" 정도의 따뜻하고 편안한 초대.

[출력 형식]
다른 어떤 설명도 붙이지 말고, 아래 JSON 형식으로만 응답하세요. 마크다운 코드 펜스(\`\`\`)도 붙이지 마세요.
{
  "bookTitle": "책 제목",
  "intro": "오프닝 초대 멘트",
  "themeQuestions": ["질문1", "질문2", "질문3", "질문4", "질문5"],
  "presenterQuestions": ["질문1", "질문2", "질문3"]
}`;

            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`;

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: `다음 도서 URL을 웹 검색으로 분석해 주세요: ${url}` }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] },
                        tools: [{ google_search: {} }]
                    })
                });

                if (!response.ok) {
                    let errMsg = `HTTP ${response.status}`;
                    try {
                        const errorData = await response.json();
                        errMsg = errorData.error?.message || errMsg;
                    } catch (_) {}
                    throw new Error(errMsg);
                }

                const data = await response.json();
                const parts = data?.candidates?.[0]?.content?.parts;
                if (!parts || !parts.length) {
                    throw new Error("AI 응답이 비어 있습니다. 다른 URL로 다시 시도해 주세요.");
                }
                const rawText = parts.map(p => p.text || '').join('').trim();
                if (!rawText) {
                    throw new Error("AI 응답에 텍스트가 없습니다.");
                }

                const result = extractJson(rawText);
                renderResult(result);

            } catch (err) {
                showError(`오류 발생: ${err.message}. API 키와 URL을 다시 확인해 주세요.`);
            }
        }

        function escapeHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderResult(data) {
            document.getElementById('res-title').innerText = data.bookTitle || '제목 없음';
            document.getElementById('res-intro').innerText = `"${data.intro || ''}"`;

            const themes = Array.isArray(data.themeQuestions) ? data.themeQuestions : [];
            const themesHtml = themes.map((q, idx) => `
                <div class="flex gap-4 p-5 rounded-xl border border-slate-100 bg-white hover:border-blue-200 hover:shadow-md transition-all">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-600 font-bold text-sm shrink-0">${idx + 1}</span>
                    <p class="text-slate-800 font-semibold leading-normal pt-1">${escapeHtml(q)}</p>
                </div>
            `).join('');
            document.getElementById('res-themes').innerHTML = themesHtml;

            const presenters = Array.isArray(data.presenterQuestions) ? data.presenterQuestions : [];
            const presenterHtml = presenters.map((q, idx) => `
                <div class="flex gap-4 p-5 rounded-xl border border-slate-200 bg-slate-900 text-white">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-white/20 text-white font-bold text-sm shrink-0">${idx + 1}</span>
                    <p class="font-medium leading-normal pt-1">${escapeHtml(q)}</p>
                </div>
            `).join('');
            document.getElementById('res-presenter').innerHTML = presenterHtml;

            setView('result');
        }
    </script>
</body>
</html>
